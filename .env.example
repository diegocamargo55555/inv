# Application Environment
APP_ENV=development
HTTP_PORT=8081
FRONTEND_PORT=3001

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres123 #alterar 
DB_NAME=invest_db
DB_SSLMODE=disable

# Cache & Message Broker (Redis)
