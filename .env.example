# Security / JWT
JWT_SECRET=supersecret-jwt-key-for-dev-only-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Market Data APIs (B3 & US Markets)
BRAPI_TOKEN=
FINNHUB_TOKEN=
