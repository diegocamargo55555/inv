# Application Environment
APP_ENV=development
HTTP_PORT=8080
FRONTEND_PORT=3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres123
